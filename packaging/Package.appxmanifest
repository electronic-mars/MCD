<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX manifest, packed by tools/pack-msix.ps1 from the publish output.

  Identity Name, Publisher and PublisherDisplayName are what Partner Center
  assigned under Product identity (Store ID 9NJRSBM7J146); a package that
  differs is refused on upload. They are printed in every published package,
  so they are no secret. The packing script patches in the version from
  Directory.Version.props; the Store replaces the signature.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="ElectronicMARS.MasterControlDock"
    Publisher="CN=952B5818-8749-4493-B354-6D30C3A586B7"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Master Control Dock</DisplayName>
    <PublisherDisplayName>Electronic MARS</PublisherDisplayName>
    <Logo>Assets\Msix\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MasterControlDock.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Master Control Dock"
        Description="A dock for the edge of every screen: system readings, temperatures, media buttons and pinned programs."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Msix\Square150x150Logo.png"
        Square44x44Logo="Assets\Msix\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Msix\Wide310x150Logo.png"
          Square310x310Logo="Assets\Msix\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\Msix\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- The packaged form of the Start with Windows toggle. Disabled until
             the person switches it on; AutoStart.cs takes this branch once the
             program runs packaged. -->
        <uap5:Extension Category="windows.startupTask" Executable="MasterControlDock.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="McdStartup" Enabled="false" DisplayName="Master Control Dock" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
