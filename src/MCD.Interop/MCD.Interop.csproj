<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kept apart from MCD.Core on purpose: CsWin32 regenerates on every change to
       NativeMethods.txt and that takes seconds, while the logic in Core is edited
       constantly. Splitting them keeps the inner loop fast. -->
  <PropertyGroup>
    <RootNamespace>Mcd.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
