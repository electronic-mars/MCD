<Project Sdk="Microsoft.NET.Sdk">

  <!-- Its own project for one reason: this is the only place in the program
       where the generated Win32 bindings are marshalled. MCD.Interop is
       generated with marshalling off, which is right for the window and shell
       calls it makes - they are handles and structs. The audio endpoint is a
       COM interface, and reaching it without marshalling means raw vtable
       pointers and reference counts by hand, which is a new way to crash a
       program that has had enough of those. The setting is per project, so
       this is a project. -->
  <PropertyGroup>
    <RootNamespace>Mcd.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
