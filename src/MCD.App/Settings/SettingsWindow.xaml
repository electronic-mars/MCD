<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mcd.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mcd.App.Settings"
    Title="Master Control Dock">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.Resources>
            <!-- Master Audio Switcher's Braun palette: graphite body, one
                 orange accent, recessed controls; cream on the light theme.
                 The accent-colour overrides repaint every accent-flavoured
                 control - toggles, sliders, selection - without touching
                 their templates. -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="BraunBg" Color="#1C1F24" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#23272D" />
                        <SolidColorBrush x:Key="BraunCard" Color="#191C21" />
                        <SolidColorBrush x:Key="BraunCardHi" Color="#212630" />
                        <SolidColorBrush x:Key="BraunLine" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="BraunLineHi" Color="#1FFFFFFF" />
                        <SolidColorBrush x:Key="BraunTx" Color="#E9ECF1" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#98A0AC" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#88909B" />
                        <SolidColorBrush x:Key="BraunLed" Color="#4ADE80" />
                        <SolidColorBrush x:Key="BraunDanger" Color="#FF6B6B" />
                        <SolidColorBrush x:Key="BraunSunk" Color="#66000000" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#191C21" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#212630" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#191C21" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#11FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="BraunBg" Color="#EDEAE3" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#F5F3EE" />
                        <SolidColorBrush x:Key="BraunCard" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="BraunCardHi" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="BraunLine" Color="#17000000" />
                        <SolidColorBrush x:Key="BraunLineHi" Color="#29000000" />
                        <SolidColorBrush x:Key="BraunTx" Color="#23262B" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#5C6169" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#626871" />
                        <SolidColorBrush x:Key="BraunLed" Color="#22A45D" />
                        <SolidColorBrush x:Key="BraunDanger" Color="#D14343" />
                        <SolidColorBrush x:Key="BraunSunk" Color="#14000000" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17000000" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#17000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

                <!-- MAS's micro-caption: small caps, wide tracking, third-level
                     text. Group names inside a page wear this. -->
                <Style x:Key="Micro" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="CharacterSpacing" Value="220" />
                    <Setter Property="Foreground" Value="{ThemeResource BraunTx3}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar area is extended into, so this row is what the user
             drags the window by. -->
        <Border x:Name="TitleBar" Height="40">
            <StackPanel
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/icon-16.png" />
                <TextBlock
                    x:Uid="TitleBarText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Master Control Dock" />
            </StackPanel>
        </Border>

        <!--
            Never folded. The control's own thresholds are 641 and 1008, so a
            window narrower than a thousand points quietly collapses its own
            navigation into an unlabelled hamburger - five pages that do not
            exist until somebody gambles on a mystery button, which is exactly
            what happened. The window now has a floor wide enough for the pane,
            so the folding is not needed and is turned off, toggle and all.
        -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            IsPaneOpen="True"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="0"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            ItemInvoked="OnItemInvoked"
            SelectionChanged="OnSectionChanged">

            <NavigationView.MenuItems>
                <!-- The pane's items draw from this program's own set, like
                     everything else in the window. A NavigationViewItem's Icon
                     slot takes an IconElement and none of those can stroke a
                     path - PathIcon fills the geometry, which turns a drawing
                     made of lines into a blob - so the drawing and the name go
                     in the item's content together, and the name keeps its own
                     x:Uid. Two icon sets in one window read as two programs,
                     and the join was the first four things on the page. -->
                <NavigationViewItem x:Uid="NavDocksItem" Tag="docks">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabDocks}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavDocks" VerticalAlignment="Center" Text="Bars" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavWidgetsItem" Tag="widgets">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabWidgets}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavWidgets" VerticalAlignment="Center" Text="Widgets" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLookItem" Tag="appearance">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabLook}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavAppearance" VerticalAlignment="Center" Text="Appearance" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGeneralItem" Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabGeneral}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavGeneral" VerticalAlignment="Center" Text="General" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSensorsItem" Tag="sensors">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabSensors}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavSensors" VerticalAlignment="Center" Text="Readings" />
                    </StackPanel>
                </NavigationViewItem>
                <!-- With the others rather than in the pane's footer: parked
                     alone at the bottom it read as a different kind of thing,
                     and it is just another page. -->
                <NavigationViewItem x:Uid="NavProgramItem" Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabProgram}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Uid="NavAbout" VerticalAlignment="Center" Text="The program" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Not a page: a switch at the foot of the pane, where the
                 pane's own pages end. It hides every bar and, worded the
                 other way round, brings them back. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavHideItem" Tag="hide" SelectsOnInvoked="False">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="{x:Bind local:IconRow.TabHide}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.1" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HideText" VerticalAlignment="Center" Text="Hide the bars" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer x:Name="Pages" Padding="36,24,36,36">
                <StackPanel MinWidth="420" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="12">

                    <!-- Docks. The bar's live picture is the editing surface:
                         what looks like the bar behaves like the bar. -->
                    <!-- Docks. The screen is chosen at the top; everything
                         below is built in code, in the order somebody asks
                         the questions in: which screen, where the bar sits,
                         what is on it, how it behaves. -->
                    <StackPanel x:Name="DocksSection">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageDocks}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="DocksTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Bars" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="DocksIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="One bar per screen. Changes land on it as you make them."
                            TextWrapping="Wrap" />

                        <!-- The display switcher, tiled the way Master Audio
                             Switcher tiles its pages: icon above, name below,
                             and a lamp for whether that screen has a bar. -->
                        <ContentControl
                            x:Name="DisplayTabs"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />

                        <StackPanel x:Name="DockBody" />
                    </StackPanel>

                    <!-- Widgets. What is on the bar, what can be put on it,
                         and the settings of whichever one was pointed at. It
                         is a page of its own because it is the part that grows:
                         every new kind of widget lands here, and it was
                         crowding the page about where the bar sits. -->
                    <StackPanel x:Name="WidgetsSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageWidgets}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="WidgetsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Widgets" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="WidgetsIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="What is on the bar of the screen chosen under Bars, and what else could be."
                            TextWrapping="Wrap" />

                        <ContentControl
                            x:Name="WidgetsTabs"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />
                        <StackPanel x:Name="WidgetsBody" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Pinned programs. A page of their own so a fresh pin is
                         seen the moment it lands, instead of surfacing as the
                         last row of a long list. -->
                    <StackPanel x:Name="PinsSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PagePins}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="PinsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Your programs" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="PinsIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Programs, folders and addresses pinned to the bar of the screen chosen under Bars."
                            TextWrapping="Wrap" />

                        <ContentControl
                            x:Name="PinsTabs"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />
                        <StackPanel x:Name="PinsBody" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Presets. Saved arrangements, apart from the widgets
                         page they used to sit at the foot of. -->
                    <StackPanel x:Name="PresetsSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PagePresets}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="PresetsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Presets" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="PresetsIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Saved arrangements of widgets. Any of them can be put onto the bar chosen under Bars."
                            TextWrapping="Wrap" />

                        <ContentControl
                            x:Name="PresetsTabs"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />
                        <StackPanel x:Name="PresetsBody" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- What is on the bar, and the settings of the one chosen:
                         the last thing on the widgets page, after what could
                         be put there. -->
                    <StackPanel x:Name="OnBarSection" Visibility="Collapsed">
                        <StackPanel x:Name="OnBarBody" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Appearance -->
                    <!-- Appearance. The rows are built in code from the Braun
                         kit: the choices here are three, five and two keys
                         wide, and a hand-written Auto column starves the
                         explanation beside it down to one letter a line. -->
                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageLook}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="AppearanceTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Appearance" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="AppearanceIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="How the bars are drawn. This applies to every one of them."
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="LookBody" />
                    </StackPanel>

                    <!-- Icons. One panel of rows, the way Master Audio Switcher
                         lists devices: the picture on the left is the button
                         that changes it, and it carries a pencil to say so. -->
                    <StackPanel x:Name="SensorsSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageSensors}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="SensorsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Sensors" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="SensorsIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Graphics and drive temperatures work out of the box. The processor and the board join in while LibreHardwareMonitor (with its Remote Web Server on) or HWiNFO (with shared memory on) is running."
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="0,14,0,7"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.Live}"
                                        Stroke="{ThemeResource BraunTx3}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="LiveReadingsTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource Micro}"
                                Text="LIVE READINGS" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SensorSummary"
                            Margin="0,-3,0,6"
                            FontSize="12"
                            Foreground="{ThemeResource BraunTx3}"
                            LineHeight="17"
                            TextWrapping="Wrap" />

                        <!-- One line per source: the silent ones are the point,
                             and a paragraph strung with semicolons hid them. -->
                        <StackPanel x:Name="SourcesList" Margin="0,0,0,10" />

                        <Border
                            Background="{ThemeResource BraunCard}"
                            BorderBrush="{ThemeResource BraunLine}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ItemsControl x:Name="SensorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SensorRow">
                                        <StackPanel>
                                        <TextBlock
                                            Padding="13,10,13,4"
                                            FontSize="11"
                                            CharacterSpacing="120"
                                            Foreground="{ThemeResource BraunTx3}"
                                            Text="{x:Bind Group}"
                                            Visibility="{x:Bind GroupShown}" />
                                        <Grid
                                            Padding="13,10"
                                            BorderBrush="{ThemeResource BraunLine}"
                                            BorderThickness="0,0,0,1"
                                            ColumnSpacing="13"
                                            Background="Transparent"
                                            DoubleTapped="OnRenameSensor"
                                            Tag="{x:Bind Key.Value}"
                                            ToolTipService.ToolTip="{x:Bind RenameHint}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="{ThemeResource BraunTx}"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource BraunTx3}"
                                                    LineHeight="17"
                                                    Text="{x:Bind Explain}"
                                                    TextWrapping="Wrap" />
                                                <!-- Which part it came off. Shown
                                                     only when that is a model
                                                     somebody owns, never the
                                                     source's own shorthand. -->
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource BraunTx3}"
                                                    Opacity="0.75"
                                                    Text="{x:Bind Hardware}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind HardwareShown}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{ThemeResource BraunTx2}"
                                                Text="{x:Bind Value, Mode=OneWay}" />

                                            <!-- The same pencil the gallery
                                                 chips wear. Renaming was a
                                                 double click announced only by
                                                 a tooltip, which is a gesture
                                                 nobody finds and a promise
                                                 only the patient read. -->
                                            <Button
                                                x:Uid="SensorRename"
                                                Grid.Column="2"
                                                Width="26"
                                                Height="24"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BraunPanelHi}"
                                                BorderBrush="{ThemeResource BraunLine}"
                                                BorderThickness="1"
                                                Click="OnRenameSensor"
                                                CornerRadius="6"
                                                Tag="{x:Bind Key.Value}">
                                                <Viewbox Width="12" Height="12">
                                                    <Canvas Width="24" Height="24">
                                                        <Path
                                                            Data="{x:Bind local:IconRow.Pencil}"
                                                            Stroke="{ThemeResource BraunTx2}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.6" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>


                    <!-- The whole machine's settings: keys, language, startup,
                         copies. Not about any one bar, and not about the
                         program's own papers either. -->
                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageGeneral}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="GeneralPageTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="General" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="GeneralIntro"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Keys, language, startup and copies - the whole program, no one bar."
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="GeneralBody" />
                    </StackPanel>

                    <!-- About, opened the way Master Audio Switcher opens its
                         own: the mark, the name, the version, centred, with
                         nothing beside them competing. -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <StackPanel x:Name="AboutBody" />
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <!-- What just happened, and the way back. Ctrl+Z always worked; a
             change that only announced itself in a hint was a change people
             were not sure had happened. -->
        <Border
            x:Name="Toast"
            Grid.Row="1"
            Margin="0,0,0,18"
            Padding="14,6,6,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource BraunPanelHi}"
            BorderBrush="{ThemeResource BraunLineHi}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="ToastText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource BraunTx}" />
                <ContentControl x:Name="ToastAction" IsTabStop="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
