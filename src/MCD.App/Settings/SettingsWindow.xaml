<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mcd.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mcd.App.Settings"
    Title="Master Control Dock">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.Resources>
            <!-- Master Audio Switcher's Braun palette: graphite body, one
                 orange accent, recessed controls; cream on the light theme.
                 The accent-colour overrides repaint every accent-flavoured
                 control - toggles, sliders, selection - without touching
                 their templates. -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <Color x:Key="SystemAccentColor">#F26A21</Color>
                        <Color x:Key="SystemAccentColorLight1">#F5854A</Color>
                        <Color x:Key="SystemAccentColorLight2">#F89F72</Color>
                        <Color x:Key="SystemAccentColorLight3">#FBBA9B</Color>
                        <Color x:Key="SystemAccentColorDark1">#D65A17</Color>
                        <Color x:Key="SystemAccentColorDark2">#B94B10</Color>
                        <Color x:Key="SystemAccentColorDark3">#9C3D0A</Color>
                        <SolidColorBrush x:Key="BraunBg" Color="#1C1F24" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#23272D" />
                        <SolidColorBrush x:Key="BraunAccBrush" Color="#F26A21" />
                        <SolidColorBrush x:Key="BraunLed" Color="#4ADE80" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#98A0AC" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#88909B" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#191C21" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#212630" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#191C21" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#F26A21" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#F5854A" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D65A17" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#140702" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#140702" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#140702" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <Color x:Key="SystemAccentColor">#F26A21</Color>
                        <Color x:Key="SystemAccentColorLight1">#F5854A</Color>
                        <Color x:Key="SystemAccentColorLight2">#F89F72</Color>
                        <Color x:Key="SystemAccentColorLight3">#FBBA9B</Color>
                        <Color x:Key="SystemAccentColorDark1">#D65A17</Color>
                        <Color x:Key="SystemAccentColorDark2">#B94B10</Color>
                        <Color x:Key="SystemAccentColorDark3">#9C3D0A</Color>
                        <SolidColorBrush x:Key="BraunBg" Color="#EDEAE3" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#F5F3EE" />
                        <SolidColorBrush x:Key="BraunAccBrush" Color="#D65A17" />
                        <SolidColorBrush x:Key="BraunLed" Color="#22A45D" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#5C6169" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#626871" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17000000" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#17000000" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#F26A21" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#F5854A" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D65A17" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#140702" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#140702" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#140702" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

                <!-- MAS's micro-caption: small caps, wide tracking, third-level
                     text. Group names inside a page wear this. -->
                <Style x:Key="Micro" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="180" />
                </Style>

                <!-- A page title: the section's icon in the accent, then the
                     name. The icon is the group's own, same as in the pane. -->
                <Style x:Key="SectionIcon" TargetType="FontIcon">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>


            <DataTemplate x:Key="IconChoiceTemplate" x:DataType="local:IconChoice">
                <Viewbox
                    Width="26"
                    Height="26"
                    Margin="4"
                    ToolTipService.ToolTip="{x:Bind Name}">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Shape}"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Canvas>
                </Viewbox>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar area is extended into, so this row is what the user
             drags the window by. -->
        <Border x:Name="TitleBar" Height="40">
            <StackPanel
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/icon-16.png" />
                <TextBlock
                    x:Uid="TitleBarText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Master Control Dock" />
            </StackPanel>
        </Border>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnSectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDocks" Content="Docks" Icon="View" Tag="docks" />
                <NavigationViewItem x:Uid="NavLauncher" Content="Launcher" Tag="launcher">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavIcons" Content="Icons" Icon="Emoji2" Tag="icons" />
                <!-- A glyph rather than a Symbol: the Symbol list is short and has
                     no colour in it, and a name it does not know is not a compile
                     error - it is a parse failure at run time that takes the
                     window, and the process, with it. -->
                <NavigationViewItem x:Uid="NavAppearance" Content="Appearance" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSensors" Content="Sensors" Tag="sensors">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavMonitors" Content="Monitors" Tag="monitors">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavAbout" Content="About" Icon="Help" Tag="about" />
            </NavigationView.FooterMenuItems>

            <ScrollViewer Padding="36,24,36,36">
                <StackPanel HorizontalAlignment="Left" MaxWidth="1000" Spacing="12">

                    <!-- Docks. The bar's live picture is the editing surface:
                         what looks like the bar behaves like the bar. -->
                    <StackPanel x:Name="DocksSection" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE890;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="DocksTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Docks" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="DocksIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="One dock per screen. Changes land on the bar as you make them."
                            TextWrapping="Wrap" />

                        <SelectorBar
                            x:Name="DockPicker"
                            Margin="0,8,0,0"
                            SelectionChanged="OnDockPicked" />

                        <TextBlock
                            x:Name="DockDetail"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid Margin="0,4,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ShowDockLabel"
                                VerticalAlignment="Center"
                                Text="Show a dock on this display" />
                            <ToggleSwitch
                                x:Name="DockEnabled"
                                x:Uid="DockEnabled"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                OffContent="Off"
                                OnContent="On"
                                Toggled="OnDockEnabledToggled" />
                        </Grid>

                        <!-- Everything the master switch governs dims with it. -->
                        <StackPanel x:Name="DockBody" Spacing="8">

                            <StackPanel Margin="0,4,0,4" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="BarLiveTitle"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource BraunTx3}"
                                        Style="{StaticResource Micro}"
                                        Text="THE BAR" />
                                    <Button
                                        x:Uid="AddWidgetButton"
                                        Grid.Column="1"
                                        Click="OnAddWidget"
                                        Content="Add widget" />
                                    <Button
                                        x:Name="UndoButton"
                                        Grid.Column="2"
                                        Click="OnUndo"
                                        Content="Undo"
                                        IsEnabled="False" />
                                </Grid>
                                <TextBlock
                                    x:Uid="BarHelp"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Drag to rearrange - here or on the bar itself. Click a widget for its options. Right-click the real bar to add a widget where you point."
                                    TextWrapping="Wrap" />

                                <Border
                                    Padding="0"
                                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid
                                        x:Name="Preview"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        PointerCanceled="OnPreviewCancelled"
                                        PointerMoved="OnPreviewMoved"
                                        PointerPressed="OnPreviewPressed"
                                        PointerReleased="OnPreviewReleased"
                                        RightTapped="OnPreviewRightTapped">
                                        <Grid x:Name="PreviewStrip" />
                                        <Canvas x:Name="PreviewOverlay" IsHitTestVisible="False" />
                                        <TextBlock
                                            x:Name="PreviewEmpty"
                                            x:Uid="PreviewEmpty"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Empty. Add a widget, or right-click the bar where you want one."
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- The inspector: whatever widget is selected on the
                                 picture above, its options live here, beside the
                                 picture that shows their effect. -->
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="InspectorTitle"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource BraunTx3}"
                                            Style="{StaticResource Micro}"
                                            Text="WIDGET" />
                                        <Button
                                            x:Name="InspectorRemove"
                                            Grid.Column="1"
                                            Click="OnInspectorRemove"
                                            Visibility="Collapsed">
                                            <TextBlock x:Uid="RemoveFromBar" Text="Remove from bar" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        x:Name="InspectorHint"
                                        x:Uid="InspectorHint"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="Click a widget on the bar above to see its options."
                                        TextWrapping="Wrap" />
                                    <ContentControl
                                        x:Name="InspectorEditor"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                x:Uid="PlacementTitle"
                                Margin="0,8,0,0"
                                Foreground="{ThemeResource BraunTx3}"
                                Style="{StaticResource Micro}"
                                Text="PLACEMENT" />
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="44" />
                                        <RowDefinition Height="Auto" MinHeight="44" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Uid="EdgeLabel"
                                        VerticalAlignment="Center"
                                        Text="Edge" />
                                    <SelectorBar
                                        x:Name="EdgeChoice"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnEdgeChosen">
                                        <SelectorBarItem x:Uid="EdgeSegLeft" Text="Left" />
                                        <SelectorBarItem x:Uid="EdgeSegTop" Text="Top" />
                                        <SelectorBarItem x:Uid="EdgeSegRight" Text="Right" />
                                        <SelectorBarItem x:Uid="EdgeSegBottom" Text="Bottom" />
                                    </SelectorBar>

                                    <TextBlock
                                        x:Name="ThicknessLabel"
                                        x:Uid="SizeLabel"
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Text="Thickness" />
                                    <SelectorBar
                                        x:Name="ThicknessChoice"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnThicknessChosen">
                                        <SelectorBarItem x:Uid="ThicknessSegDefault" Text="Default" />
                                        <SelectorBarItem x:Uid="ThicknessSegCompact" Text="Compact" />
                                    </SelectorBar>

                                    <!-- Replaces the row, never greys it: a setting
                                         that cannot act is not offered. -->
                                    <TextBlock
                                        x:Name="ThicknessNote"
                                        x:Uid="ThicknessNote"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="A bar down the side of the screen has one thickness."
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <TextBlock
                                x:Uid="BehaviourTitle"
                                Margin="0,8,0,0"
                                Foreground="{ThemeResource BraunTx3}"
                                Style="{StaticResource Micro}"
                                Text="BEHAVIOUR" />
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="44" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" MinHeight="44" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Uid="BehaviourLabel"
                                        VerticalAlignment="Center"
                                        Text="Hide until you point at its edge" />
                                    <ToggleSwitch
                                        x:Name="DockAutoHide"
                                        x:Uid="DockAutoHide"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        OffContent="Off"
                                        OnContent="On"
                                        Toggled="OnDockAutoHideToggled" />

                                    <TextBlock
                                        x:Name="HideNote"
                                        x:Uid="HideNote"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="The taskbar already hides on this edge, so this dock stays visible."
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        x:Uid="TopmostLabel"
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Text="Keep above other windows" />
                                    <ToggleSwitch
                                        x:Name="DockTopmost"
                                        x:Uid="DockTopmost"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        OffContent="Off"
                                        OnContent="On"
                                        Toggled="OnDockTopmostToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Launcher -->
                    <StackPanel x:Name="LauncherSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE71D;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="LauncherTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Launcher" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="LauncherIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Programs, folders and pages pinned to the bar. They appear on every dock, in this order."
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="PinButton"
                            Margin="0,8,0,0"
                            Click="OnPinDialog"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE710;" />
                                <TextBlock x:Uid="PinButtonText" Text="Pin something" />
                            </StackPanel>
                        </Button>

                        <ItemsControl x:Name="LauncherList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LauncherRow">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind Target}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    x:Uid="MoveUpButton"
                                                    Click="OnMoveLaunchItem"
                                                    Content="&#xE74A;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Move up" />
                                                <Button
                                                    x:Uid="PickLaunchIcon"
                                                    Click="OnLaunchIconPick"
                                                    Content="Icon"
                                                    Tag="{x:Bind Id}" />
                                                <Button
                                                    x:Uid="RemoveLaunchButton"
                                                    Click="OnRemoveLaunchItem"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearanceSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE790;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="AppearanceTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Appearance" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="AppearanceIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="How the bars are drawn. This applies to every dock."
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,8,0,0"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="16">

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Uid="ThemeLabel" Text="Theme" />
                                        <TextBlock
                                            x:Uid="ThemeHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Light or dark, or the same as Windows."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="ThemeChoice"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnAppearanceChanged">
                                        <ComboBoxItem x:Uid="ThemeSystemItem" Content="Same as Windows" />
                                        <ComboBoxItem x:Uid="ThemeLightItem" Content="Light" />
                                        <ComboBoxItem x:Uid="ThemeDarkItem" Content="Dark" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Uid="BackgroundLabel" Text="Background" />
                                        <TextBlock
                                            x:Uid="BackgroundHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Translucent lets the desktop through; solid is easier to read over a busy wallpaper and costs a little less to draw."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="BackdropChoice"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnAppearanceChanged">
                                        <ComboBoxItem x:Uid="BackdropTranslucentItem" Content="Translucent" />
                                        <ComboBoxItem x:Uid="BackdropSolidItem" Content="Solid" />
                                        <ComboBoxItem x:Uid="BackdropColourItem" Content="A colour of my own" />
                                        <ComboBoxItem x:Uid="BackdropImageItem" Content="A picture" />
                                        <ComboBoxItem x:Uid="BackdropBraunItem" Content="Instrument body (Braun)" />
                                    </ComboBox>
                                </Grid>

                                <Grid
                                    x:Name="BackdropExtras"
                                    ColumnSpacing="16"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Border
                                            x:Name="BackdropSwatch"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                        <TextBlock
                                            x:Name="BackdropDetail"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BackdropPick"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        HorizontalAlignment="Right"
                                        Click="OnBackdropPick" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Uid="AccentLabel" Text="Colour of the readings" />
                                        <TextBlock
                                            x:Uid="AccentHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="The accent colour comes from your Windows settings. Readings past their warning level keep their warning colour either way."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="AccentChoice"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnAppearanceChanged">
                                        <ComboBoxItem x:Uid="AccentNeutralItem" Content="Plain text colour" />
                                        <ComboBoxItem x:Uid="AccentWindowsItem" Content="Windows accent colour" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Uid="LanguageLabel" Text="Language" />
                                        <TextBlock
                                            x:Uid="LanguageHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Takes effect the next time the program starts."
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="RestartNow"
                                            Margin="0,6,0,0"
                                            Click="OnRestartNow"
                                            Visibility="Collapsed">
                                            <TextBlock x:Uid="RestartNowText" Text="Restart now" />
                                        </Button>
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="LanguageChoice"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem x:Uid="LanguageSystemItem" Content="Same as Windows" />
                                        <ComboBoxItem Content="English" />
                                        <ComboBoxItem Content="Русский" />
                                    </ComboBox>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Icons -->
                    <StackPanel x:Name="IconsSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE76E;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="IconsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Icons" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="IconsIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Pick the picture each reading is drawn with. The choice applies to every dock."
                            TextWrapping="Wrap" />

                        <ItemsControl x:Name="IconList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:IconRow">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />

                                            <Button
                                                Grid.Column="1"
                                                Padding="10,6"
                                                Click="OnPickIcon"
                                                Tag="{x:Bind Id}">
                                                <Viewbox Width="22" Height="22">
                                                    <Canvas Width="24" Height="24">
                                                        <Path
                                                            Data="{x:Bind Shape, Mode=OneWay}"
                                                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sensors -->
                    <StackPanel x:Name="SensorsSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="SensorsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Sensors" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="SensorsIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Graphics and drive temperatures work out of the box. The processor and the board join in while LibreHardwareMonitor (with its Remote Web Server on) or HWiNFO (with shared memory on) is running."
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="LiveReadingsTitle"
                            Margin="0,16,0,0"
                            Foreground="{ThemeResource BraunTx3}" Style="{StaticResource Micro}"
                            Text="LIVE READINGS" />
                        <TextBlock
                            x:Name="SensorSummary"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <ItemsControl x:Name="SensorList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SensorRow">
                                    <Grid
                                        Padding="12,7"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind Hardware}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{x:Bind Value, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Monitors -->
                    <StackPanel x:Name="MonitorsSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="MonitorsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Monitors" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="MonitorsIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Every screen this program has seen, and how it recognises them. Entries are kept until you remove them here."
                            TextWrapping="Wrap" />

                        <ItemsControl x:Name="MonitorList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MonitorRow">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Detail}" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind StableId}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind DevicePath}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                x:Uid="ForgetButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Click="OnForget"
                                                Content="Forget"
                                                IsEnabled="{x:Bind CanForget}"
                                                Tag="{x:Bind StableId}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE897;" Foreground="{ThemeResource BraunAccBrush}" Style="{StaticResource SectionIcon}" />
                            <TextBlock
                                x:Uid="AboutTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="About" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" />
                        <TextBlock
                            x:Uid="AboutIntro"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="A dock for the edge of your screen. Free software under GPL-3.0-or-later; parts adapted from Microsoft PowerToys under the MIT licence."
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,8,0,0"
                            Padding="16,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid MinHeight="48" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="StartWithWindowsLabel" Text="Start with Windows" />
                                    <TextBlock
                                        x:Uid="StartWithWindowsHint"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="The docks come back when you sign in." />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartToggle"
                                    x:Uid="AutoStartToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="OnAutoStartToggled" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Uid="OpenLogsButton" Click="OnOpenLogs" Content="Open the log folder" />
                            <Button x:Uid="OpenConfigButton" Click="OnOpenConfig" Content="Open the settings folder" />
                        </StackPanel>

                        <TextBlock
                            x:Uid="ExitHint"
                            Margin="0,24,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Closing this window leaves the docks running. To stop them, use the button below - ending the task from Task Manager leaves the reserved screen space behind."
                            TextWrapping="Wrap" />

                        <Button
                            x:Uid="ExitButton"
                            Margin="0,8,0,0"
                            Click="OnExit"
                            Content="Exit Master Control Dock" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
