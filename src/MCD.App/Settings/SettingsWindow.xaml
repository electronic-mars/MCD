<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mcd.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mcd.App.Settings"
    Title="Master Control Dock">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.Resources>
            <!-- Master Audio Switcher's Braun palette: graphite body, one
                 orange accent, recessed controls; cream on the light theme.
                 The accent-colour overrides repaint every accent-flavoured
                 control - toggles, sliders, selection - without touching
                 their templates. -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="BraunBg" Color="#1C1F24" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#23272D" />
                        <SolidColorBrush x:Key="BraunCard" Color="#191C21" />
                        <SolidColorBrush x:Key="BraunCardHi" Color="#212630" />
                        <SolidColorBrush x:Key="BraunLine" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="BraunLineHi" Color="#1FFFFFFF" />
                        <SolidColorBrush x:Key="BraunTx" Color="#E9ECF1" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#98A0AC" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#88909B" />
                        <SolidColorBrush x:Key="BraunLed" Color="#4ADE80" />
                        <SolidColorBrush x:Key="BraunDanger" Color="#FF6B6B" />
                        <SolidColorBrush x:Key="BraunSunk" Color="#66000000" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#191C21" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#11FFFFFF" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#212630" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#191C21" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#11FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="BraunBg" Color="#EDEAE3" />
                        <SolidColorBrush x:Key="BraunPanelHi" Color="#F5F3EE" />
                        <SolidColorBrush x:Key="BraunCard" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="BraunCardHi" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="BraunLine" Color="#17000000" />
                        <SolidColorBrush x:Key="BraunLineHi" Color="#29000000" />
                        <SolidColorBrush x:Key="BraunTx" Color="#23262B" />
                        <SolidColorBrush x:Key="BraunTx2" Color="#5C6169" />
                        <SolidColorBrush x:Key="BraunTx3" Color="#626871" />
                        <SolidColorBrush x:Key="BraunLed" Color="#22A45D" />
                        <SolidColorBrush x:Key="BraunDanger" Color="#D14343" />
                        <SolidColorBrush x:Key="BraunSunk" Color="#14000000" />
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17000000" />
                        <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F7F5F1" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#17000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

                <!-- MAS's micro-caption: small caps, wide tracking, third-level
                     text. Group names inside a page wear this. -->
                <Style x:Key="Micro" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="CharacterSpacing" Value="220" />
                    <Setter Property="Foreground" Value="{ThemeResource BraunTx3}" />
                </Style>


            <DataTemplate x:Key="IconChoiceTemplate" x:DataType="local:IconChoice">
                <Viewbox
                    Width="26"
                    Height="26"
                    Margin="4"
                    ToolTipService.ToolTip="{x:Bind Name}">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Shape}"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Canvas>
                </Viewbox>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar area is extended into, so this row is what the user
             drags the window by. -->
        <Border x:Name="TitleBar" Height="40">
            <StackPanel
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/icon-16.png" />
                <TextBlock
                    x:Uid="TitleBarText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Master Control Dock" />
            </StackPanel>
        </Border>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            CompactModeThresholdWidth="820"
            ExpandedModeThresholdWidth="980"
            PaneDisplayMode="Auto"
            SelectionChanged="OnSectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDocks" Content="Docks" Icon="View" Tag="docks" />
                <NavigationViewItem x:Uid="NavIcons" Content="Icons" Icon="Emoji2" Tag="icons" />
                <!-- The one place a glyph from the system's font is still drawn.
                     A navigation item's Icon slot takes an IconElement, and none
                     of those can stroke a path - PathIcon fills the geometry,
                     which turns a drawing made of lines into a blob. The pane
                     is the framework's own chrome; everything this program
                     draws itself comes from its own set.

                     A glyph rather than a Symbol: the Symbol list is short and
                     has no colour in it, and a name it does not know is not a
                     compile error - it is a parse failure at run time that
                     takes the window, and the process, with it. -->
                <NavigationViewItem x:Uid="NavAppearance" Content="Appearance" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSensors" Content="Sensors" Tag="sensors">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavAbout" Content="About" Icon="Help" Tag="about" />
            </NavigationView.FooterMenuItems>

            <ScrollViewer x:Name="Pages" Padding="36,24,36,36">
                <StackPanel MinWidth="420" MaxWidth="1000" HorizontalAlignment="Left" Spacing="12">

                    <!-- Docks. The bar's live picture is the editing surface:
                         what looks like the bar behaves like the bar. -->
                    <!-- Docks. The screen is chosen at the top; everything
                         below is built in code, in the order somebody asks
                         the questions in: which screen, where the bar sits,
                         what is on it, how it behaves. -->
                    <StackPanel x:Name="DocksSection" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageDocks}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="DocksTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Docks" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="DocksIntro"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="One dock per screen. Changes land on the bar as you make them."
                            TextWrapping="Wrap" />

                        <!-- The display switcher, tiled the way Master Audio
                             Switcher tiles its pages: icon above, name below,
                             and a lamp for whether that screen has a bar. -->
                        <ContentControl
                            x:Name="DisplayTabs"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />

                        <StackPanel x:Name="DockBody" />
                    </StackPanel>

                    <!-- Appearance -->
                    <!-- Appearance. The rows are built in code from the Braun
                         kit: the choices here are three, five and two keys
                         wide, and a hand-written Auto column starves the
                         explanation beside it down to one letter a line. -->
                    <StackPanel x:Name="AppearanceSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageLook}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="AppearanceTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Appearance" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="AppearanceIntro"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="How the bars are drawn. This applies to every dock."
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="LookBody" />
                    </StackPanel>

                    <!-- Icons. One panel of rows, the way Master Audio Switcher
                         lists devices: the picture on the left is the button
                         that changes it, and it carries a pencil to say so. -->
                    <StackPanel x:Name="IconsSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageIcons}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="IconsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Icons" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="IconsIntro"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Pick the picture each reading is drawn with. The choice applies to every dock."
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="3,14,0,7"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.Readings}"
                                        Stroke="{ThemeResource BraunTx3}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="ReadingIconsTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource Micro}"
                                Text="READINGS" />
                        </StackPanel>

                        <Border
                            Background="{ThemeResource BraunCard}"
                            BorderBrush="{ThemeResource BraunLine}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ItemsControl x:Name="IconList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IconRow">
                                        <Grid Padding="13,10" ColumnSpacing="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The tile is the picker. It is
                                                 large because the drawing is
                                                 the thing being chosen, and a
                                                 44-point target is a kind one. -->
                                            <Button
                                                Width="46"
                                                Height="46"
                                                Padding="0"
                                                Background="{ThemeResource BraunCardHi}"
                                                BorderBrush="{ThemeResource BraunLine}"
                                                BorderThickness="1"
                                                Click="OnPickIcon"
                                                CornerRadius="13"
                                                Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind Label}">
                                                <Grid>
                                                    <Viewbox
                                                        Width="26"
                                                        Height="26"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path
                                                                Data="{x:Bind Shape, Mode=OneWay}"
                                                                Stroke="{ThemeResource BraunTx}"
                                                                StrokeEndLineCap="Round"
                                                                StrokeLineJoin="Round"
                                                                StrokeStartLineCap="Round"
                                                                StrokeThickness="1.5" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Border
                                                        Width="17"
                                                        Height="17"
                                                        Margin="0,0,-6,-6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Background="{ThemeResource BraunPanelHi}"
                                                        BorderBrush="{ThemeResource BraunLineHi}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                        <Viewbox Width="9" Height="9">
                                                            <Canvas Width="24" Height="24">
                                                                <Path
                                                                    Data="{x:Bind local:IconRow.Pencil}"
                                                                    Stroke="{ThemeResource BraunTx2}"
                                                                    StrokeEndLineCap="Round"
                                                                    StrokeLineJoin="Round"
                                                                    StrokeStartLineCap="Round"
                                                                    StrokeThickness="2.2" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="{ThemeResource BraunTx}"
                                                    Text="{x:Bind Label}" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource BraunTx3}"
                                                    LineHeight="17"
                                                    Text="{x:Bind Explain}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel
                            Margin="3,14,0,7"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.Pinned}"
                                        Stroke="{ThemeResource BraunTx3}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="PinnedIconsTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource Micro}"
                                Text="PINNED PROGRAMS" />
                        </StackPanel>
                        <Border
                            Padding="13,10"
                            Background="{ThemeResource BraunCard}"
                            BorderBrush="{ThemeResource BraunLine}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="PinnedIconsRow"
                                    FontSize="14"
                                    Foreground="{ThemeResource BraunTx}"
                                    Text="A pinned program keeps its own icon" />
                                <TextBlock
                                    x:Uid="PinnedIconsHint"
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource BraunTx3}"
                                    LineHeight="17"
                                    Text="A pinned program keeps the icon Windows gives it. To draw it with one of these instead, right-click it on the bar and choose Settings."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sensors. Name, what it means, and what it says now.
                         Double-click a name to change it: the one the source
                         ships is whatever its maker put in the firmware. -->
                    <StackPanel x:Name="SensorsSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.PageSensors}"
                                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="SensorsTitle"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Sensors" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="SensorsIntro"
                            Foreground="{ThemeResource BraunTx2}"
                            Text="Graphics and drive temperatures work out of the box. The processor and the board join in while LibreHardwareMonitor (with its Remote Web Server on) or HWiNFO (with shared memory on) is running."
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="3,14,0,7"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind local:IconRow.Live}"
                                        Stroke="{ThemeResource BraunTx3}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Uid="LiveReadingsTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource Micro}"
                                Text="LIVE READINGS" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SensorSummary"
                            Margin="3,0,0,8"
                            FontSize="12"
                            Foreground="{ThemeResource BraunTx3}"
                            LineHeight="17"
                            TextWrapping="Wrap" />

                        <Border
                            Background="{ThemeResource BraunCard}"
                            BorderBrush="{ThemeResource BraunLine}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ItemsControl x:Name="SensorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SensorRow">
                                        <Grid
                                            Padding="13,10"
                                            ColumnSpacing="13"
                                            Background="Transparent"
                                            DoubleTapped="OnRenameSensor"
                                            Tag="{x:Bind Key.Value}"
                                            ToolTipService.ToolTip="{x:Bind RenameHint}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="{ThemeResource BraunTx}"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource BraunTx3}"
                                                    LineHeight="17"
                                                    Text="{x:Bind Explain}"
                                                    TextWrapping="Wrap" />
                                                <!-- Which part it came off. Shown
                                                     only when that is a model
                                                     somebody owns, never the
                                                     source's own shorthand. -->
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource BraunTx3}"
                                                    Opacity="0.75"
                                                    Text="{x:Bind Hardware}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind HardwareShown}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{ThemeResource BraunTx2}"
                                                Text="{x:Bind Value, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>


                    <!-- About, opened the way Master Audio Switcher opens its
                         own: the mark, the name, the version, centred, with
                         nothing beside them competing. -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <StackPanel x:Name="AboutBody" />
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
