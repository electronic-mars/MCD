<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Mcd.App.Widgets.Views.WidgetTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:widgets="using:Mcd.App.Widgets">

    <!-- The critical red from Master Audio Switcher: firmer than Fluent's
         salmon, which washed out over the acrylic. A shade deeper on the
         light theme, where #FF6B6B has too little against a pale bar. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="McdCriticalBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="McdRailFill" Color="#73000000" />
            <SolidColorBrush x:Key="McdRailLine" Color="#11FFFFFF" />
            <SolidColorBrush x:Key="McdRailShade" Color="#40000000" />
            <SolidColorBrush x:Key="McdKeyInk" Color="#FFE9ECF1" />
            <SolidColorBrush x:Key="McdLedOn" Color="#FF4ADE80" />
            <SolidColorBrush x:Key="McdLedSocket" Color="#66000000" />
            <SolidColorBrush x:Key="McdReadingAccent" Color="#FFF26A21" />
            <RadialGradientBrush x:Key="McdLedHalo">
                <GradientStop Offset="0" Color="#5A4ADE80" />
                <GradientStop Offset="1" Color="#004ADE80" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="McdCriticalBrush" Color="#C63B3B" />
            <SolidColorBrush x:Key="McdRailFill" Color="#21000000" />
            <SolidColorBrush x:Key="McdRailLine" Color="#17000000" />
            <SolidColorBrush x:Key="McdRailShade" Color="#1F000000" />
            <SolidColorBrush x:Key="McdKeyInk" Color="#FF2B2E33" />
            <SolidColorBrush x:Key="McdLedOn" Color="#FF22A45D" />
            <SolidColorBrush x:Key="McdLedSocket" Color="#33000000" />
            <SolidColorBrush x:Key="McdReadingAccent" Color="#FFD65A17" />
            <RadialGradientBrush x:Key="McdLedHalo">
                <GradientStop Offset="0" Color="#4D22A45D" />
                <GradientStop Offset="1" Color="#0022A45D" />
            </RadialGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <widgets:IconConverter x:Key="Icon" />

    <!-- A ContentControl with no template renders no background, border or
         corner at all - which is why the hover fill, the edit outline and the
         transport caps were invisible until this existed. The bar's own
         controls (HoverChip, WidgetHost, TransportKey) all take it. -->
    <ControlTemplate x:Key="BareContent" TargetType="ContentControl">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
    </ControlTemplate>


    <!--
        One reading: a drawn icon, then the figure. The numbers use a monospaced
        face on purpose - with proportional digits the text changes width on
        every update and the whole bar twitches once a second.
    -->
    <DataTemplate x:Key="MetricTemplate" x:DataType="widgets:Metric">
        <widgets:HoverChip
            Margin="{x:Bind Spacing, Mode=OneWay}"
            Visibility="{x:Bind Visibility, Mode=OneWay}">
            <!-- The reading first, its name under it. A bar is glanced at, and
                 what someone hovering wants is confirmation of the number and
                 which part it belongs to - not a second copy of the panel they
                 are already looking at. -->
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text, Mode=OneWay}" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Detail, Mode=OneWay}" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- A stroked Path, not a PathIcon. PathIcon fills the geometry,
                     and these shapes are drawn as lines: filled, the processor
                     becomes a plain square and the network arrows disappear
                     altogether. -->
                <Viewbox
                    Width="{x:Bind IconSize, Mode=OneWay}"
                    Height="{x:Bind IconSize, Mode=OneWay}"
                    VerticalAlignment="Center">
                    <!-- The Canvas fixes the 24-unit grid the icons are drawn on, so
                         every one scales by the same amount whatever its own bounds
                         happen to be. -->
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Icon, Converter={StaticResource Icon}, Mode=OneWay}"
                            Stroke="{x:Bind Colour, Mode=OneWay}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Canvas>
                </Viewbox>

                <FontIcon
                    Margin="-4,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{x:Bind Colour, Mode=OneWay}"
                    Glyph="&#xE7BA;"
                    Opacity="{x:Bind AlertOpacity, Mode=OneWay}"
                    Visibility="{x:Bind AlertVisible, Mode=OneWay}">
                    <FontIcon.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </FontIcon.OpacityTransition>
                </FontIcon>

                <!-- The interface face, as PowerToys uses, rather than a
                     monospaced one: Consolas draws noticeably smaller digits at
                     the same point size, which is why ours read smaller than
                     theirs even after the sizes were raised past theirs.
                     Proportional digits do change width as the figure changes,
                     so the width is reserved and capped instead - the number
                     moves inside its own box and nothing further along the bar
                     shifts. -->
                <StackPanel Margin="{x:Bind Lift, Mode=OneWay}" VerticalAlignment="Center">
                    <TextBlock
                        MinWidth="{x:Bind ValueWidth, Mode=OneWay}"
                        MaxWidth="{x:Bind ValueWidth, Mode=OneWay}"
                        HorizontalTextAlignment="Left"
                        FontSize="{x:Bind FontSize, Mode=OneWay}"
                        FontWeight="{x:Bind ValueWeight, Mode=OneWay}"
                        Foreground="{x:Bind Colour, Mode=OneWay}"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <!-- Capped, as PowerToys caps theirs. A drive's name is its
                         model number and runs to twenty characters; left to size
                         itself it makes one reading three times the width of its
                         neighbours. -->
                    <TextBlock
                        MaxWidth="100"
                        Margin="0,-2,0,0"
                        HorizontalAlignment="Left"
                        HorizontalTextAlignment="Left"
                        FontSize="{x:Bind LabelFontSize, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind LabelVisible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <DataTemplate x:Key="mcd.load" x:DataType="widgets:LoadWidget">
        <ItemsControl ItemTemplate="{StaticResource MetricTemplate}" ItemsSource="{x:Bind Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Classic Binding, not x:Bind: inside an ItemsPanelTemplate
                         there is no compiled binding target, and the data context
                         here is the widget itself. -->
                    <StackPanel Orientation="{Binding Orientation}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="mcd.temperature" x:DataType="widgets:TemperatureWidget">
        <ItemsControl ItemTemplate="{StaticResource MetricTemplate}" ItemsSource="{x:Bind Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Classic Binding, not x:Bind: inside an ItemsPanelTemplate
                         there is no compiled binding target, and the data context
                         here is the widget itself. -->
                    <StackPanel Orientation="{Binding Orientation}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <!--
        One button on the bar: no border, no fill of its own, and the system's
        hover and press brushes underneath. The default Button style leaves the
        resting state to the instance and keeps its own brushes for the rest.
    -->
    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- A stretch of empty bar. Invisible at rest; while a widget is being
         dragged it shows itself so it can be grabbed too. -->
    <DataTemplate x:Key="mcd.spacer" x:DataType="widgets:SpacerWidget">
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent">
            <Border
                MinWidth="8"
                MinHeight="8"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="4"
                Visibility="{x:Bind HintVisible, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76F;" />
            </Border>
        </Border>
    </DataTemplate>

    <!-- Whatever is playing. The three buttons a media key would press, and on
         the full-size bar the name of the track under them. -->
    <DataTemplate x:Key="mcd.media" x:DataType="widgets:MediaWidget">
        <StackPanel
            Margin="{x:Bind Spacing, Mode=OneWay}"
            Opacity="{x:Bind Dim, Mode=OneWay}"
            Orientation="{x:Bind Orientation}">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </StackPanel.OpacityTransition>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <Border
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Visibility="{x:Bind ArtVisible, Mode=OneWay}">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!-- The player block from Master Audio Switcher: a rail recessed
                     into the body holding three caps, glyphs printed in ink.
                     Real inset shadows do not exist here; the translucent black
                     fill plus a darker top hairline inside is the honest
                     approximation, and it reads over any backdrop. -->
                <Border
                    Height="{x:Bind RailHeight, Mode=OneWay}"
                    Padding="{x:Bind RailPadding, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Background="{ThemeResource McdRailFill}"
                    BorderBrush="{ThemeResource McdRailLine}"
                    BorderThickness="1"
                    CornerRadius="{x:Bind RailCorner, Mode=OneWay}">
                    <Border
                        BorderBrush="{ThemeResource McdRailShade}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="{x:Bind RailInnerCorner, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="{x:Bind KeySpacing, Mode=OneWay}">

                            <!-- The lamp: an unlit socket that is always there,
                                 and the green LED with its glow while sound is
                                 actually coming out. -->
                            <Grid Width="{x:Bind LampWidth, Mode=OneWay}" VerticalAlignment="Stretch">
                                <Ellipse
                                    Width="{x:Bind LedSize, Mode=OneWay}"
                                    Height="{x:Bind LedSize, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource McdLedSocket}" />
                                <Ellipse
                                    Width="{x:Bind HaloSize, Mode=OneWay}"
                                    Height="{x:Bind HaloSize, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource McdLedHalo}"
                                    Visibility="{x:Bind PlayingVisible, Mode=OneWay}" />
                                <Ellipse
                                    Width="{x:Bind LedSize, Mode=OneWay}"
                                    Height="{x:Bind LedSize, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource McdLedOn}"
                                    Visibility="{x:Bind PlayingVisible, Mode=OneWay}" />
                            </Grid>

                            <widgets:TransportKey
                                x:Uid="MediaPrevKey"
                                Width="{x:Bind KeyWidth, Mode=OneWay}"
                                Height="{x:Bind KeyHeight, Mode=OneWay}"
                                Command="{x:Bind PreviousCommand}"
                                CornerRadius="{x:Bind KeyCorner, Mode=OneWay}"
                                ToolTipService.ToolTip="Previous">
                                <Viewbox Width="{x:Bind GlyphSize, Mode=OneWay}" Height="{x:Bind GlyphSize, Mode=OneWay}">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="{x:Bind PreviousIcon, Converter={StaticResource Icon}, Mode=OneTime}"
                                            Stroke="{ThemeResource McdKeyInk}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Canvas>
                                </Viewbox>
                            </widgets:TransportKey>

                            <widgets:TransportKey
                                Width="{x:Bind KeyWidth, Mode=OneWay}"
                                Height="{x:Bind KeyHeight, Mode=OneWay}"
                                Command="{x:Bind PlayPauseCommand}"
                                CornerRadius="{x:Bind KeyCorner, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind PlayTip, Mode=OneWay}">
                                <Viewbox Width="{x:Bind GlyphSize, Mode=OneWay}" Height="{x:Bind GlyphSize, Mode=OneWay}">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="{x:Bind PlayGlyph, Converter={StaticResource Icon}, Mode=OneTime}"
                                            Opacity="{x:Bind PlayShown, Mode=OneWay}"
                                            Stroke="{ThemeResource McdKeyInk}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2">
                                            <Path.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.1" />
                                            </Path.OpacityTransition>
                                        </Path>
                                        <Path
                                            Data="{x:Bind PauseGlyph, Converter={StaticResource Icon}, Mode=OneTime}"
                                            Opacity="{x:Bind PauseShown, Mode=OneWay}"
                                            Stroke="{ThemeResource McdKeyInk}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2">
                                            <Path.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.1" />
                                            </Path.OpacityTransition>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </widgets:TransportKey>

                            <widgets:TransportKey
                                x:Uid="MediaNextKey"
                                Width="{x:Bind KeyWidth, Mode=OneWay}"
                                Height="{x:Bind KeyHeight, Mode=OneWay}"
                                Command="{x:Bind NextCommand}"
                                CornerRadius="{x:Bind KeyCorner, Mode=OneWay}"
                                ToolTipService.ToolTip="Next">
                                <Viewbox Width="{x:Bind GlyphSize, Mode=OneWay}" Height="{x:Bind GlyphSize, Mode=OneWay}">
                                    <Canvas Width="24" Height="24">
                                        <Path
                                            Data="{x:Bind NextIcon, Converter={StaticResource Icon}, Mode=OneTime}"
                                            Stroke="{ThemeResource McdKeyInk}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Canvas>
                                </Viewbox>
                            </widgets:TransportKey>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>

            <TextBlock
                MaxWidth="160"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="{x:Bind FontSize, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind TitleVisible, Mode=OneWay}" />
        </StackPanel>
    </DataTemplate>

    <!--
        The launcher. A plain Button with a transparent background: the default
        style leaves the normal state to the instance and keeps its own brushes
        for hover and press, so this gets the system's own feedback for free.
    -->
    <DataTemplate x:Key="mcd.launcher" x:DataType="widgets:LauncherWidget">
        <ItemsControl ItemsSource="{x:Bind Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="widgets:LaunchButton">
                    <Button
                        Margin="{x:Bind Spacing, Mode=OneWay}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="3"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind LaunchCommand}"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind Name}">
                        <Grid Width="16" Height="16">
                            <Viewbox Visibility="{x:Bind ChosenVisible}">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="{x:Bind Chosen, Converter={StaticResource Icon}, Mode=OneTime}"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>
                            <Image
                                Source="{x:Bind Icon, Mode=OneWay}"
                                Stretch="Uniform"
                                Visibility="{x:Bind AutoVisible}" />
                            <!-- Until the icon arrives, and for a target that has
                                 none, the first letter of the name. An empty
                                 square would read as a broken button. -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="{x:Bind Initial}"
                                Visibility="{x:Bind Placeholder, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
