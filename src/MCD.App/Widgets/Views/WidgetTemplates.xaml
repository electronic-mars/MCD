<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Mcd.App.Widgets.Views.WidgetTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:widgets="using:Mcd.App.Widgets">

    <!-- The critical red from Master Audio Switcher: firmer than Fluent's
         salmon, which washed out over the acrylic. A shade deeper on the
         light theme, where #FF6B6B has too little against a pale bar. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="McdCriticalBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="McdReadingAccent" Color="#FFF26A21" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="McdCriticalBrush" Color="#C63B3B" />
            <SolidColorBrush x:Key="McdReadingAccent" Color="#FFD65A17" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <widgets:IconConverter x:Key="Icon" />

    <!-- A ContentControl with no template renders no background, border or
         corner at all - which is why the hover fill, the edit outline and the
         transport caps were invisible until this existed. The bar's own
         controls (HoverChip, WidgetHost, TransportKey) all take it. -->
    <ControlTemplate x:Key="BareContent" TargetType="ContentControl">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
    </ControlTemplate>


    <!--
        One reading: a drawn icon, then the figure. The numbers use a monospaced
        face on purpose - with proportional digits the text changes width on
        every update and the whole bar twitches once a second.
    -->
    <DataTemplate x:Key="MetricTemplate" x:DataType="widgets:Metric">
        <widgets:HoverChip
            Margin="{x:Bind Spacing, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind Visibility, Mode=OneWay}">
            <!-- The reading first, its name under it. A bar is glanced at, and
                 what someone hovering wants is confirmation of the number and
                 which part it belongs to - not a second copy of the panel they
                 are already looking at. -->
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text, Mode=OneWay}" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Detail, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Story, Mode=OneWay}"
                            Visibility="{x:Bind StoryShown, Mode=OneWay}" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <!-- Spacing carried by margins, not by StackPanel.Spacing: the
                 spacing slot is dealt out around every child, the collapsed
                 alert bell included, and those six invisible points pushed the
                 ink past the box - the corner clip then shaved the icon's
                 left edge. Found with a ruler on a 96-DPI bar. -->
            <StackPanel Orientation="Horizontal">
                <!-- A stroked Path, not a PathIcon. PathIcon fills the geometry,
                     and these shapes are drawn as lines: filled, the processor
                     becomes a plain square and the network arrows disappear
                     altogether. -->
                <Viewbox
                    Width="{x:Bind IconSize, Mode=OneWay}"
                    Height="{x:Bind IconSize, Mode=OneWay}"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center">
                    <!-- The Canvas fixes the 24-unit grid the icons are drawn on, so
                         every one scales by the same amount whatever its own bounds
                         happen to be. -->
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Icon, Converter={StaticResource Icon}, Mode=OneWay}"
                            Stroke="{x:Bind Colour, Mode=OneWay}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{x:Bind Stroke, Mode=OneWay}" />
                    </Canvas>
                </Viewbox>

                <FontIcon
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{x:Bind Colour, Mode=OneWay}"
                    Glyph="&#xE7BA;"
                    Opacity="{x:Bind AlertOpacity, Mode=OneWay}"
                    Visibility="{x:Bind AlertVisible, Mode=OneWay}">
                    <FontIcon.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </FontIcon.OpacityTransition>
                </FontIcon>

                <!-- The interface face, as PowerToys uses, rather than a
                     monospaced one: Consolas draws noticeably smaller digits at
                     the same point size, which is why ours read smaller than
                     theirs even after the sizes were raised past theirs.
                     Proportional digits do change width as the figure changes,
                     so the width is reserved and capped instead - the number
                     moves inside its own box and nothing further along the bar
                     shifts. -->
                <StackPanel Margin="{x:Bind Lift, Mode=OneWay}" VerticalAlignment="Center">
                    <!-- The number in one box and its unit in another, each
                         as wide as that reading can ever need. The digits are
                         right-aligned, so they grow leftwards into room kept
                         for them and the unit stays where it is; nothing on
                         the chip moves when a reading crosses ten. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock
                            MinWidth="{x:Bind FigureWidth, Mode=OneWay}"
                            MaxWidth="{x:Bind FigureWidth, Mode=OneWay}"
                            HorizontalTextAlignment="Right"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            FontWeight="{x:Bind ValueWeight, Mode=OneWay}"
                            Foreground="{x:Bind Colour, Mode=OneWay}"
                            Text="{x:Bind Figure, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MinWidth="{x:Bind SuffixWidth, Mode=OneWay}"
                            HorizontalTextAlignment="Left"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            FontWeight="{x:Bind ValueWeight, Mode=OneWay}"
                            Foreground="{x:Bind Colour, Mode=OneWay}"
                            Text="{x:Bind Suffix, Mode=OneWay}" />
                    </StackPanel>
                    <!-- Capped, as PowerToys caps theirs. A drive's name is its
                         model number and runs to twenty characters; left to size
                         itself it makes one reading three times the width of its
                         neighbours. -->
                    <TextBlock
                        MaxWidth="100"
                        Margin="0,-2,0,0"
                        HorizontalAlignment="Left"
                        HorizontalTextAlignment="Left"
                        FontSize="{x:Bind LabelFontSize, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Label, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind CaptionShown, Mode=OneWay}" />
                    <!-- A device's charge wears a battery here instead: its
                         name is in the hover, and on the bar it only cost width. -->
                    <Viewbox
                        Width="{x:Bind BadgeSize}"
                        Height="{x:Bind BadgeSize}"
                        Margin="0,-1,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind BadgeShown, Mode=OneWay}">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{x:Bind Badge, Converter={StaticResource Icon}, Mode=OneWay}"
                                Stroke="{x:Bind BadgeColour, Mode=OneWay}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="{x:Bind BadgeStroke}" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <!-- One reading in one slot. Still an ItemsControl over a one-entry list:
         the metric chip template serves both widgets unchanged. -->
    <!-- One chip, held directly: an ItemsControl measures to nothing before
         its containers exist, and the host stood two points wide while the
         chip painted itself in overflow. -->
    <DataTemplate x:Key="mcd.gauge" x:DataType="widgets:GaugeWidget">
        <ContentControl
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsTabStop="False"
            Content="{x:Bind Front, Mode=OneWay}"
            ContentTemplate="{StaticResource MetricTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="mcd.temp" x:DataType="widgets:TempWidget">
        <ContentControl
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsTabStop="False"
            Content="{x:Bind Front, Mode=OneWay}"
            ContentTemplate="{StaticResource MetricTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="mcd.device" x:DataType="widgets:DeviceWidget">
        <ContentControl
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsTabStop="False"
            Content="{x:Bind Front, Mode=OneWay}"
            ContentTemplate="{StaticResource MetricTemplate}" />
    </DataTemplate>

    <!-- Sound: a speaker that says how loud, and a press that silences. -->
    <DataTemplate x:Key="mcd.sound" x:DataType="widgets:SoundWidget">
        <widgets:HoverChip
            Margin="3,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind Shown, Mode=OneWay}">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <TextBlock FontSize="13" Text="{x:Bind Detail, Mode=OneWay}" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Viewbox
                    Width="{x:Bind IconSize, Mode=OneWay}"
                    Height="{x:Bind IconSize, Mode=OneWay}"
                    VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Icon, Mode=OneWay, Converter={StaticResource Icon}}"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{x:Bind Stroke, Mode=OneWay}" />
                    </Canvas>
                </Viewbox>
                <!-- In a box of its own, right-aligned: the per cent sign
                     then keeps its place while the digits change under it,
                     and the speaker beside them never shifts. -->
                <TextBlock
                    MinWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    MaxWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalTextAlignment="Right"
                    FontSize="{x:Bind FontSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="{x:Bind LevelShown, Mode=OneWay}"
                    Text="{x:Bind Level, Mode=OneWay}"
                    Visibility="{x:Bind LevelVisible, Mode=OneWay}" />
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <!-- The way in: one wheel, one slot, and a press that opens the window.
         It draws nothing that changes, so nothing here updates. -->
    <DataTemplate x:Key="mcd.settings" x:DataType="widgets:SettingsWidget">
        <!-- The whole slot, accounted for: margin 6 + icon 24 is the slot
             exactly, so the chip's usual side padding has to go - with it the
             wheel sat in a box six points narrower than its ink, and the
             corner clip shaved both sides of it. -->
        <widgets:HoverChip
            Margin="3,0"
            Padding="0,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <TextBlock x:Uid="SettingsChipTip" FontSize="13" Text="Settings" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <Viewbox
                Width="{x:Bind IconSize}"
                Height="{x:Bind IconSize}"
                VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path
                        Data="{x:Bind Icon, Converter={StaticResource Icon}, Mode=OneTime}"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="{x:Bind Stroke, Mode=OneTime}" />
                </Canvas>
            </Viewbox>
        </widgets:HoverChip>
    </DataTemplate>

    <!--
        Battery and Wi-Fi are drawn the same way: an icon that carries the
        reading on its own, and a figure beside it on a bar with room. Both
        vanish entirely on a machine they are not about, which the bar arranges
        by giving them no slot rather than by drawing something invisible.
    -->
    <DataTemplate x:Key="mcd.battery" x:DataType="widgets:BatteryWidget">
        <widgets:HoverChip Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <TextBlock FontSize="13" Text="{x:Bind Detail, Mode=OneWay}" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <!-- Down the side of a screen the figure goes under the drawing:
                 86 points of width is not enough to put them side by side, and
                 that is the shape somebody picks when the screen is small. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="{x:Bind Orientation}"
                Spacing="4">
                <!-- Drawn here rather than chosen from the icon set. The set
                     has four batteries - empty, two bars, four bars, and a
                     bolt - so eighty-five per cent and twenty looked the same,
                     and charging showed no level at all. A body and a bar
                     inside it read at a glance and at any value, and the bar
                     is the only thing that moves. -->
                <Viewbox
                    Width="{x:Bind IconSize, Mode=OneWay}"
                    Height="{x:Bind IconSize, Mode=OneWay}"
                    VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Rectangle
                            Canvas.Left="2"
                            Canvas.Top="7.5"
                            Width="18"
                            Height="9"
                            RadiusX="3"
                            RadiusY="3"
                            Stroke="{x:Bind Colour, Mode=OneWay}"
                            StrokeThickness="{x:Bind Stroke, Mode=OneWay}" />
                        <Rectangle
                            Canvas.Left="4"
                            Canvas.Top="9.5"
                            Width="{x:Bind Fill, Mode=OneWay}"
                            Height="5"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Fill="{x:Bind Colour, Mode=OneWay}" />
                        <Rectangle
                            Canvas.Left="21"
                            Canvas.Top="10"
                            Width="1.6"
                            Height="4"
                            RadiusX="0.8"
                            RadiusY="0.8"
                            Fill="{x:Bind Colour, Mode=OneWay}" />
                        <Path
                            Data="M 13.4 6.2 L 9.6 12.4 L 12.6 12.4 L 11.4 17.8 L 15.2 11.6 L 12.2 11.6 Z"
                            Fill="{x:Bind Colour, Mode=OneWay}"
                            Stroke="#66000000"
                            StrokeThickness="1.2"
                            Visibility="{x:Bind Charging, Mode=OneWay}" />
                    </Canvas>
                </Viewbox>
                <TextBlock
                    MinWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    MaxWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalTextAlignment="Right"
                    FontSize="{x:Bind FontSize, Mode=OneWay}"
                    Foreground="{x:Bind Colour, Mode=OneWay}"
                    Text="{x:Bind Level, Mode=OneWay}"
                    Visibility="{x:Bind LevelVisible, Mode=OneWay}" />
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <DataTemplate x:Key="mcd.wifi" x:DataType="widgets:WifiWidget">
        <widgets:HoverChip Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <TextBlock FontSize="13" Text="{x:Bind Detail, Mode=OneWay}" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Viewbox
                    Width="{x:Bind IconSize, Mode=OneWay}"
                    Height="{x:Bind IconSize, Mode=OneWay}"
                    VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Icon, Mode=OneWay, Converter={StaticResource Icon}}"
                            Stroke="{x:Bind Colour, Mode=OneWay}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{x:Bind Stroke, Mode=OneWay}" />
                    </Canvas>
                </Viewbox>
                <!-- A name reads from the left, so this box is filled from
                     the left; the width is the one the slot was reserved
                     for, so joining a shorter network moves nothing. -->
                <TextBlock
                    MinWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    MaxWidth="{x:Bind FigureWidth, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalTextAlignment="Left"
                    FontSize="{x:Bind FontSize, Mode=OneWay}"
                    Foreground="{x:Bind Colour, Mode=OneWay}"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind NameVisible, Mode=OneWay}" />
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <!-- The time, and the date under it on a full-size bar. Tabular figures
         so the minute changing does not shuffle the hour along. -->
    <DataTemplate x:Key="mcd.clock" x:DataType="widgets:ClockWidget">
        <!-- A chip like everything else, which is also what gives the tooltip
             its window. The hover answers what the bar has no room for: the
             seconds, and the date written out in full. -->
        <widgets:HoverChip Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <TextBlock FontSize="13" Text="{x:Bind Detail, Mode=OneWay}" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <!-- The interface face, like everything else on the bar. Consolas
                 draws noticeably smaller digits at the same point size, so the
                 clock came out smaller than the readings beside it; the width
                 is reserved from the longest the pattern ever gets, so nothing
                 shuffles when the hour changes. -->
            <TextBlock
                MinWidth="{x:Bind TimeWidth, Mode=OneWay}"
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                FontSize="{x:Bind TimeSize, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind Time, Mode=OneWay}" />
            <TextBlock
                MinWidth="{x:Bind DateWidth, Mode=OneWay}"
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                FontSize="{x:Bind DateSize, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Date, Mode=OneWay}"
                Visibility="{x:Bind DateVisible, Mode=OneWay}" />
            </StackPanel>
        </widgets:HoverChip>
    </DataTemplate>

    <!--
        One button on the bar: no border, no fill of its own, and the system's
        hover and press brushes underneath. The default Button style leaves the
        resting state to the instance and keeps its own brushes for the rest.
    -->
    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Whatever is playing. The three buttons a media key would press, and on
         the full-size bar the name of the track under them. -->
    <DataTemplate x:Key="mcd.media" x:DataType="widgets:MediaWidget">
        <StackPanel
            Margin="{x:Bind Spacing, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="{x:Bind Dim, Mode=OneWay}"
            Orientation="{x:Bind Orientation}">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </StackPanel.OpacityTransition>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="0">

                <!-- The playing thing's own artwork. Pressing it brings that
                     program forward - the picture is the door to the player. -->
                <Button
                    x:Uid="MediaArtButton"
                    Margin="0,0,4,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind RaisePlayerCommand}"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Open the player"
                    Visibility="{x:Bind ArtVisible, Mode=OneWay}">
                    <Border Width="20" Height="20" CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Button>

                <Button
                    x:Uid="MediaPrevKey"
                    Command="{x:Bind PreviousCommand}"
                    Style="{StaticResource BarButton}"
                    ToolTipService.ToolTip="Previous">
                    <Viewbox Width="{x:Bind IconSize, Mode=OneWay}" Height="{x:Bind IconSize, Mode=OneWay}">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{x:Bind PreviousIcon, Converter={StaticResource Icon}, Mode=OneTime}"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button
                    Command="{x:Bind PlayPauseCommand}"
                    Style="{StaticResource BarButton}"
                    ToolTipService.ToolTip="{x:Bind PlayTip, Mode=OneWay}">
                    <Viewbox Width="{x:Bind IconSize, Mode=OneWay}" Height="{x:Bind IconSize, Mode=OneWay}">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{x:Bind PlayGlyph, Converter={StaticResource Icon}, Mode=OneTime}"
                                Opacity="{x:Bind PlayShown, Mode=OneWay}"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5">
                                <Path.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.1" />
                                </Path.OpacityTransition>
                            </Path>
                            <Path
                                Data="{x:Bind PauseGlyph, Converter={StaticResource Icon}, Mode=OneTime}"
                                Opacity="{x:Bind PauseShown, Mode=OneWay}"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5">
                                <Path.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.1" />
                                </Path.OpacityTransition>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button
                    x:Uid="MediaNextKey"
                    Command="{x:Bind NextCommand}"
                    Style="{StaticResource BarButton}"
                    ToolTipService.ToolTip="Next">
                    <Viewbox Width="{x:Bind IconSize, Mode=OneWay}" Height="{x:Bind IconSize, Mode=OneWay}">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="{x:Bind NextIcon, Converter={StaticResource Icon}, Mode=OneTime}"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <TextBlock
                MaxWidth="160"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="{x:Bind FontSize, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                Visibility="{x:Bind TitleVisible, Mode=OneWay}" />
        </StackPanel>
    </DataTemplate>

    <!--
        One pinned icon in one slot. A plain Button with a transparent
        background: the default style leaves the normal state to the instance
        and keeps its own brushes for hover and press, so this gets the
        system's own feedback for free.
    -->
    <DataTemplate x:Key="mcd.icon" x:DataType="widgets:IconWidget">
        <!-- Margin 4 + padding 4 + box 20 is 28: inside the slot on both
             densities. It was 32 in a slot of 30 - or 26, compact - and the
             button's corner clip shaved a pinned icon on both sides. -->
        <Button
            Margin="{x:Bind Item.Spacing, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="0"
            MinHeight="0"
            Padding="2"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind Item.LaunchCommand}"
            CornerRadius="4">
            <ToolTipService.ToolTip>
                <ToolTip Placement="Bottom">
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind Item.Name}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Item.Target}" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <Grid Width="20" Height="20">
                <Viewbox Visibility="{x:Bind Item.ChosenVisible}">
                    <Canvas Width="24" Height="24">
                        <Path
                            Data="{x:Bind Item.Chosen, Converter={StaticResource Icon}, Mode=OneTime}"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Canvas>
                </Viewbox>
                <Image
                    Source="{x:Bind Item.Icon, Mode=OneWay}"
                    Stretch="Uniform"
                    Visibility="{x:Bind Item.AutoVisible}" />
                <!-- Until the icon arrives, and for a target that has
                     none, the first letter of the name. An empty
                     square would read as a broken button. -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{x:Bind Item.Initial}"
                    Visibility="{x:Bind Item.Placeholder, Mode=OneWay}" />
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
