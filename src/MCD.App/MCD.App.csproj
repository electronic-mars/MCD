<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mcd.App</RootNamespace>
    <AssemblyName>MasterControlDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged during development: it needs no Visual Studio workload and
         `dotnet run` just works. The MSIX is produced at release time by
         makeappx from the publish output, the way MAS does it. Everything that
         differs between the two modes goes through AppPaths.IsPackaged. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Not compiled ahead of time. ReadyToRun doubled the Windows SDK
         projection alone (25 MB to 56 MB) and added 46 MB in all; measured
         on 08.10.2026 it bought 150 ms to the first bar on a warm start
         (515 ms against 665 ms) and nothing on a cold one (2.8 s either way). -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>

    <!-- The XAML compiler emits code we do not control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCD.Audio\MCD.Audio.csproj" />
    <ProjectReference Include="..\MCD.Core\MCD.Core.csproj" />
    <ProjectReference Include="..\MCD.Sensors\MCD.Sensors.csproj" />
    <ProjectReference Include="..\MCD.Interop\MCD.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- The unattended self-test (MCD_SELFTEST*) is compiled in for Debug, and for Release only on request: -p:SelfTest=true -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(SelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>

</Project>
