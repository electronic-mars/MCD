<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Mcd.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Mcd.App.Widgets.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Created as a type, not loaded by Source. A resource
                     dictionary with x:Class referenced by Source loads itself
                     from inside its own InitializeComponent the first time a key
                     is looked up, and the recursion ends as an access violation
                     inside the runtime with no managed stack to show for it. -->
                <views:WidgetTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
